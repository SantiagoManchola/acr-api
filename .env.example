# Conexión MySQL (driver pymysql). Ajusta usuario/clave/host según tu entorno.
DATABASE_URL=mysql+pymysql://acr_user:acr_password@localhost:3306/acr

# JWT
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (separa varios orígenes con comas)
CORS_ORIGINS=*

# Usuario administrador inicial (usado por seed.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Cloudflare R2 — evidencias fotográficas (opcionales).
# Sin estas variables, /evidencias/presign responde 501 y los registros se guardan sin foto.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=acr-evidencias
R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev
